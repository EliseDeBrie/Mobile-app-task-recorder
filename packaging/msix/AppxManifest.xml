<?xml version="1.0" encoding="utf-8"?>
<!--
  The package manifest for the Store build. make_msix.py copies this next to
  the program, fills in the identity and the version, and packs the folder.

  The three identity values are placeholders on purpose: the real ones are
  assigned when the app's name is reserved in Partner Center (Product
  management > Product identity) and belong in the repository's variables,
  not in the source. See docs/STORE.md.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Warehouse Step Recorder</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Description>Records the Warehouse Management mobile app on a PC and writes a step-by-step Word guide, with a screenshot per step. Everything stays on the machine.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <!-- uap10 (packagedClassicApp) needs Windows 10 2004; the OCR built into
         Windows, which the recorder prefers, has been there far longer. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Capabilities>
    <!-- A packaged desktop program: it watches a screen region and listens
         for taps and Enter through ordinary Windows hooks, which no
         sandboxed capability covers. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application
      Id="WHSTaskRecorder"
      Executable="app\WHS Task Recorder.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="Warehouse Step Recorder"
        Description="Step-by-step Word guides for the Warehouse Management mobile app."
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="#1F3864" />
    </Application>
  </Applications>
</Package>
